# Application
QT_APP_NAME=QuantTrader
QT_ENVIRONMENT=dev
QT_TIMEZONE=UTC

# Logging
QT_LOG_LEVEL=INFO
QT_LOG_JSON_LOGS=true

# Database (dev default sqlite; can point to postgres URL)
QT_DB_URL=sqlite:///quant_trader.db
QT_DB_POOL_SIZE=5

# Ops
QT_HEALTH_STALE_THRESHOLD_SECONDS=30
QT_SCHEDULER_ENABLED=true
QT_ALERT_WEBHOOK_URL=
QT_METRICS_NAMESPACE=quant_trader
